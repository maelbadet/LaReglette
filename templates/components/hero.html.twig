<section class="home-hero" aria-labelledby="hero-title">
    <div class="site-container hero-grid">
        <div class="hero-copy">
            <p class="eyebrow">La Réglette · L'esprit grimpe</p>
            <h1 id="hero-title">Chaque prise.<br>Un nouveau<br><span>départ.</span></h1>
            <p class="hero-description">Du premier mouvement au dernier effort, l'escalade est une aventure qui se partage. Trouvez votre rythme, relevez vos défis et prenez de la hauteur.</p>
            <div class="hero-actions">
                {% if app.user %}
                    <a class="button-link" href="#esprit">Bienvenue {{ app.user.firstName }} <span aria-hidden="true">↗</span></a>
                {% else %}
                    <a class="button-link" href="{{ path('app_register') }}">Rejoindre La Réglette <span aria-hidden="true">↗</span></a>
                {% endif %}
                <a class="text-link" href="#esprit">Découvrir notre esprit <span aria-hidden="true">↓</span></a>
            </div>
        </div>
        <div class="hero-art" aria-hidden="true">
            <div class="hero-contour contour-one"></div><div class="hero-contour contour-two"></div><div class="hero-contour contour-three"></div>
            <span class="climbing-hold hold-one"></span><span class="climbing-hold hold-two"></span><span class="climbing-hold hold-three"></span>
            <span class="art-caption">PRENEZ DE LA HAUTEUR.</span><span class="art-number">01 / ∞</span>
        </div>
    </div>
</section>
